{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "angaros",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "android/app/build.gradle.kts" },
        { "type": "generic", "path": "pc/pyproject.toml" },
        { "type": "json", "path": "worker/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server.json", "jsonpath": "$.packages[0].version" }
      ]
    }
  }
}
